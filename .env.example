# BYOC Platform Environment Configuration Example

# Runtime Mode (development | production | test)
NODE_ENV=development
PORT=3000

# Production Vault Master Key (Must base64-decode to exactly 32 bytes)
# Generate via: openssl rand -base64 32
VAULT_MASTER_KEY=

# Production Cookie Session Secret (At least 32 bytes)
# Generate via: openssl rand -hex 32
SESSION_SECRET=

# Public Application URL (Used for email links and CORS)
APP_URL=http://localhost:3000

# Allowed CORS Origins (Comma-separated, no space)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection String (Defaults to PGlite local storage if omitted)
DATABASE_URL=

# SMTP Mail Transport URL (Required for production email verification & password resets)
# Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=

# Require Dynamic Sandbox Test Execution in QC Gate (default false)
REQUIRE_TEST_EXECUTION=false
